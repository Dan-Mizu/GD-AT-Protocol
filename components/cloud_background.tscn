[gd_scene load_steps=4 format=3 uid="uid://doxsqt5ydwfwm"]

[sub_resource type="Shader" id="Shader_s6ube"]
code = "shader_type canvas_item;

uniform vec4 BackColor   : source_color = vec4(0.0, 0.4, 0.8, 1.0);
uniform vec4 CloudColor  : source_color = vec4(0.2, 0.6, 0.8, 1.0);

// Base automatic movement speed (TIME-based)
uniform float base_speed : hint_range(0.0, 5.0) = 0.5;

// Additional movement strength from the mouse
uniform float mouse_speed : hint_range(0.0, 5.0) = 0.3;

// Mouse position in UV space (set from script, 0–1)
uniform vec2 MouseUV = vec2(0., 0.);

float Func(float pX) {
	return 0.6 * (0.5 * sin(0.1 * pX) + 0.5 * sin(0.553 * pX) + 0.7 * sin(1.2 * pX));
}

float FuncR(float pX) {
	return 0.5 + 0.25 * (1.0 + sin(mod(40.0 * pX, TAU)));
}

float Layer(vec2 pQ, float pT) {
	vec2 Qt = 3.5 * pQ;
	pT *= 0.5;
	Qt.x += pT;

	float Xi = floor(Qt.x);
	float Xf = Qt.x - Xi - 0.5;

	vec2 C;
	float Yi;
	float D = 1.0 - step(Qt.y, Func(Qt.x));

	// Disk
	Yi = Func(Xi + 0.5);
	C  = vec2(Xf, Qt.y - Yi);
	D  = min(D, length(C) - FuncR(Xi + pT / 80.0));

	// Previous disk
	Yi = Func(Xi + 1.0 + 0.5);
	C  = vec2(Xf - 1.0, Qt.y - Yi);
	D  = min(D, length(C) - FuncR(Xi + 1.0 + pT / 80.0));

	// Next disk
	Yi = Func(Xi - 1.0 + 0.5);
	C  = vec2(Xf + 1.0, Qt.y - Yi);
	D  = min(D, length(C) - FuncR(Xi - 1.0 + pT / 80.0));

	return min(1.0, D);
}

void fragment() {
	// Base UV transform (unchanged from your version)
	vec2 uv = 3.0 * (vec2(1.5) - UV * 2.0);

	// --- Automatic (time-based) movement ---

	// Base time offset that drives horizontal drift
	// You can tweak 1.0 to change global speed scaling.
	float t_base = TIME * base_speed * 1.0;

	// --- Mouse-based influence ---

	// Map MouseUV from [0,1] to [-1,1]
	vec2 mouse_centered = (MouseUV - 0.5) * 2.0;

	// Split horizontal vs vertical mouse influence,
	// scaled by mouse_speed.
	float mouse_x = mouse_centered.x * mouse_speed;
	float mouse_y = mouse_centered.y * mouse_speed;

	vec3 color = BackColor.rgb;

	for (float J = 0.0; J <= 1.0; J += 0.2) {
		// J acts like \"depth\": 0 = back, 1 = front

		// Time-based horizontal motion:
		// - base factor grows slightly with depth so different layers move at different rates
		float t_layer = t_base * (0.5 + 2.0 * J) * (1.0 + 0.1 * sin(226.0 * J));

		// Additional horizontal influence from mouse
		// Back layers (J small) move more with mouse, fronts less
		float mouse_x_parallax = mouse_x * (1.0 - J);

		// Combine base time and mouse-driven X-motion
		float Lt = (t_layer + mouse_x_parallax) + 17.0 * J;

		// Vertical base placement for each layer
		float base_y = 0.3 + 1.5 * (J - 0.5);

		// Mouse-driven vertical parallax: back layers move more
		float mouse_y_parallax = mouse_y * (1.0 - J) * 0.5; // 0.5 is a tuning factor

		vec2 Lp = vec2(0.0, base_y + mouse_y_parallax);

		float L = Layer(uv + Lp, Lt);

		float blur = 4.0 * (0.5 * abs(2.0 - 5.0 * J)) / (11.0 - 5.0 * J);
		float V    = mix(0.0, 1.0, 1.0 - smoothstep(0.0, 0.01 + 0.2 * blur, L));
		vec3 Lc    = mix(CloudColor.rgb, vec3(1.0), J);

		color = mix(color, Lc, V);
	}

	COLOR = vec4(color, 1.0);
}"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_0lt4e"]
shader = SubResource("Shader_s6ube")
shader_parameter/BackColor = Color(0, 0.4, 0.8, 1)
shader_parameter/CloudColor = Color(0.2, 0.6, 0.8, 1)
shader_parameter/base_speed = 0.50000002375
shader_parameter/mouse_speed = 0.30000001425
shader_parameter/MouseUV = Vector2(0, 0)

[sub_resource type="GDScript" id="GDScript_s6ube"]
resource_name = "CloudBackground"
script/source = "extends ColorRect

func _process(_delta: float) -> void:
	# Get mouse position in viewport pixel space
	var mouse_pos: Vector2 = get_viewport().get_mouse_position()
	var rect_size: Vector2 = get_viewport().get_visible_rect().size

	# Convert to UV space (0–1)
	var mouse_uv: Vector2 = Vector2(
		mouse_pos.x / max(rect_size.x, 1.0),
		mouse_pos.y / max(rect_size.y, 1.0)
	)

	if material is ShaderMaterial: material.set_shader_parameter(\"MouseUV\", mouse_uv)
"

[node name="CloudBackground" type="ColorRect"]
material = SubResource("ShaderMaterial_0lt4e")
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
